{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug api with Nx",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "nx",
        "serve",
        "api"
      ],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/api/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Start web with Nx",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "nx",
        "serve",
        "web"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Start studio with Nx",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "nx",
        "serve",
        "studio"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "GitNexus serve",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "gitnexus:serve"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against web (localhost:4200)",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/apps/web"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against studio (localhost:4201)",
      "url": "http://localhost:4201",
      "webRoot": "${workspaceFolder}/apps/studio"
    }
  ],
  "compounds": [
    {
      "name": "Start all apps (api + web + studio)",
      "configurations": [
        "Debug api with Nx",
        "Start web with Nx",
        "Start studio with Nx"
      ],
      "stopAll": true
    }
  ]
}
